+// simpleEmbed generates a deterministic hash-based embedding vector from text.
+// Uses SimHash: each word hashes to a dimension, accumulating +/- contributions.
+// Not semantically meaningful, but enables cosine similarity for dedup/conflict detection.
+func simpleEmbed(text string, dim int) []float32 {
+	vec := make([]float32, dim)
+	words := strings.Fields(strings.ToLower(text))
+	for _, word := range words {
+		// Simple hash: FNV-1a-like
+		h := uint32(2166136261)
+		for _, c := range word {
+			h ^= uint32(c)
+			h *= 16777619
+		}
+		idx := int(h%uint32(dim))
+		if idx < 0 { idx = -idx }
+		// Alternate +/- based on second hash bit
+		if h&2 == 0 {
+			vec[idx] += 1.0
+		} else {
+			vec[idx] -= 1.0
+		}
+	}
+	// L2 normalize
+	var norm float64
+	for _, v := range vec { norm += float64(v) * float64(v) }
+	if norm > 0 {
+		norm = math.Sqrt(norm)
+		for i := range vec { vec[i] = float32(float64(vec[i]) / norm) }
+	}
+	return vec
+}
