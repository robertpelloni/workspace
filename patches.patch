+	}
+	if appendErr := GlobalVectorStore.AppendScratchpadValue(ctx, key, value); appendErr != nil {
+		return err(fmt.Sprintf("scratchpad append failed: %v", appendErr))
+	}
+	return ok(fmt.Sprintf("Appended to scratchpad key '%s'", key))
+}
