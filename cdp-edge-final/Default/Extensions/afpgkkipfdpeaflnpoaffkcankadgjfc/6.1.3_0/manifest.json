{
   "action": {
      "default_popup": "popup.html",
      "default_title": "Default Popup Title"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content-scripts/content.js" ],
      "matches": [ "\u003Call_urls>" ]
   } ],
   "description": "Browser extension for the supermemory app",
   "homepage_url": "https://supermemory.ai",
   "host_permissions": [ "*://x.com/*", "*://twitter.com/*", "*://supermemory.ai/*", "*://api.supermemory.ai/*", "*://chatgpt.com/*", "*://chat.openai.com/*", "https://*.posthog.com/*" ],
   "icons": {
      "128": "icon-128x128.png",
      "144": "icon-144x144.png",
      "152": "icon-152x152.png",
      "16": "icon-16.png",
      "192": "icon-192x192.png",
      "256": "icon-256x256.png",
      "384": "icon-384x384.png",
      "48": "icon-48x48.png",
      "512": "icon-512x512.png",
      "72": "icon-72x72.png",
      "96": "icon-96x96.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "supermemory",
   "permissions": [ "storage", "activeTab", "webRequest", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "6.1.3",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "icon-16.png", "fonts/*.ttf" ]
   } ]
}
