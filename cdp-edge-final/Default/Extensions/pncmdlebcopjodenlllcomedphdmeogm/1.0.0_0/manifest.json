   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "AnythingLLM Browser Companion",
   "permissions": [ "contextMenus", "activeTab", "storage", "notifications", "alarms" ],
