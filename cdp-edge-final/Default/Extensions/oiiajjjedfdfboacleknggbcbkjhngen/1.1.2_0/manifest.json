{
   "action": {
      "default_popup": "popup/popup.html",
      "default_title": "Multi Search & Multi AI"
   },
   "background": {
      "service_worker": "o.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "rh.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_end"
   } ],
   "description": "Search or Chat with ChatGPT, Claude, Google, Reddit and many more — all at once, without switching tabs! 10x Producivity speed boost",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Multi Search & Multi AI",
   "omnibox": {
      "keyword": "ms"
   },
   "permissions": [ "webNavigation", "declarativeNetRequest", "storage", "tabs", "contextMenus" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.2",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "new-tab/index.html" ]
   }, {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "icons/icon-32.png" ]
   } ]
}
