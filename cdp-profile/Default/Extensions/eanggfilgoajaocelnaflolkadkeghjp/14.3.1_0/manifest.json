{
   "action": {
      "default_icon": {
         "48": "img/badges/badge-48-day.png"
      },
      "default_title": "HARPA AI | Browser's Mind"
   },
   "background": {
      "service_worker": "/bg.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "exclude_matches": [ "https://harpa.ai/oi", "http://localhost:3000/oi", "http://localhost:3010/oi" ],
      "js": [ "/cs.js" ],
      "matches": [ "*://*/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "/cs-openai.js" ],
      "matches": [ "https://*.openai.com/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "/css/harpa.css" ],
      "exclude_matches": [ "https://harpa.ai/oi", "http://localhost:3000/oi", "http://localhost:3010/*" ],
      "js": [ "/cs-web.js" ],
      "matches": [ "https://harpa.ai/*", "http://localhost:3000/*", "http://localhost:3010/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "css": [ "/css/fastspring.css" ],
      "matches": [ "https://harpaai.test.onfastspring.com/*", "https://harpaai.onfastspring.com/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "default_locale": "en",
   "description": "__MSG_ext_description__",
   "host_permissions": [ "*://*/*" ],
   "icons": {
      "128": "img/icons/icon-128.png",
      "500": "img/icons/icon-500.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_ext_name__",
   "optional_host_permissions": [ "\u003Call_urls>" ],
   "optional_permissions": [ "downloads" ],
   "permissions": [ "alarms", "background", "browsingData", "cookies", "declarativeNetRequest", "notifications", "tabs", "storage", "offscreen", "scripting", "contextMenus", "sidePanel" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "14.3.1",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "oi.js", "nj.js", "nj.css", "nj-engine.js", "nj-engine.css", "nj-youtube.js", "nj-chatgpt.js", "js/timer-worker.js", "js/pdf.min.js", "js/pdf.worker.min.js", "js/xlsx.mini.min.js", "js/mammoth.browser.min.js", "img/misc/shortcut.svg", "img/commands/*.svg", "lang/*.json", "harpa.html" ]
   } ]
}
