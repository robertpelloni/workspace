      "_execute_action": {
         "description": "Toggle Recall extension",
         "suggested_key": {
            "default": "Alt+R",
            "mac": "Alt+R"
         }
      },
      "save-card": {
         "description": "Save card",
         "suggested_key": {
            "default": "Alt+S",
            "mac": "Alt+S"
         }
      }
   },
   "description": "Curate an AI that knows what you know. Save what matters. Write what you think. Chat with your knowledge in the AI model you choose.",
   "externally_connectable": {
      "matches": [ "*://localhost/*", "https://*.recall.it/*", "https://*.recall-app.com/*", "https://*.recall.wiki/*", "https://*.getrecall.ai/*", "https://*.recall-308915--recall-2-0-spefgvtw.web.app/*" ]
   },
   "homepage_url": "https://www.recall.it",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "assets/images/icon-128.png",
      "16": "assets/images/icon-16.png",
      "32": "assets/images/icon-32.png",
      "48": "assets/images/icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Recall | Your Knowledge is Your Edge",
   "options_page": "options.html",
   "permissions": [ "tabs", "storage", "bookmarks", "scripting", "activeTab", "tabGroups" ],
