{
   "action": {
      "default_title": "Retriever AI - Open Side Panel"
   },
   "background": {
      "service_worker": "background.iife.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "description": "Open Retriever Side Panel.",
         "suggested_key": {
            "default": "Alt+R",
            "mac": "MacCtrl+R"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content/all.iife.js" ],
      "matches": [ "http://*/*", "https://*/*", "\u003Call_urls>" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "content-main/all.iife.js" ],
      "matches": [ "http://*/*", "https://*/*", "\u003Call_urls>" ],
      "run_at": "document_start",
      "world": "MAIN"
   } ],
   "content_security_policy": {
      "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; child-src 'self';"
   },
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "externally_connectable": {
      "matches": [ "https://rtrvr.ai/*", "https://www.rtrvr.ai/*", "http://localhost/*", "http://127.0.0.1/*" ]
   },
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icon-128.png",
      "16": "icon-16.png",
      "32": "icon-32.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extensionName__",
   "oauth2": {
      "client_id": "714736390407-guv3os7qt87nb52fnunhnok0uub5tj2m.apps.googleusercontent.com",
      "scopes": [ "https://www.googleapis.com/auth/userinfo.email", "https://www.googleapis.com/auth/userinfo.profile", "https://www.googleapis.com/auth/drive.file", "https://www.googleapis.com/auth/calendar.calendarlist.readonly", "https://www.googleapis.com/auth/calendar.events.freebusy", "https://www.googleapis.com/auth/calendar.events.readonly" ]
   },
   "omnibox": {
      "keyword": "rtrvr"
   },
   "permissions": [ "storage", "scripting", "activeTab", "identity", "alarms", "tabGroups", "notifications", "contextMenus", "offscreen", "sidePanel", "clipboardRead", "gcm", "webNavigation", "webRequest", "cookies" ],
   "sandbox": {
      "pages": [ "sandbox/index.html", "dynamic-content/index.html" ]
   },
   "side_panel": {
      "default_path": "side-panel/index.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "33.0.0",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "*.js", "*.mjs", "*.css", "*.svg", "icon-128.png", "icon-32.png" ]
   } ]
}
