{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Get TLDR"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "content-youtube.css" ],
      "js": [ "youtube-transcript.js", "content-youtube.js" ],
      "matches": [ "*://*.youtube.com/*" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "AI-powered Text and YouTube summarization with custom prompts",
   "host_permissions": [ "https://www.get-tldr.com/*", "http://localhost/*", "https://*.youtube.com/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Get TLDR - AI Summarizer & Content Management",
   "permissions": [ "storage", "activeTab", "scripting", "contextMenus", "notifications" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.19",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "saved-summaries.html", "saved-summaries-modern.html", "saved-summaries-modern.js", "marked.min.js", "youtube-transcript.js", "content-sidebar.js", "content-sidebar.css", "tokens.css", "content-youtube.js", "content-youtube.css", "icons/icon48.png" ]
   } ]
}
